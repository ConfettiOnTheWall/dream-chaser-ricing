/* ---- Waybar Dark Red Flat ---- */

/* Background da barra */
#waybar {
    background: #1a1a1a;
    color: #e6e6e6;
    font-family: "JetBrains Mono", "FiraCode Nerd Font", monospace;
    font-size: 12px;
    border: none;
}
#mpris {
  color: #1DB954; /* verde Spotify */
  padding: 0 8px;
  font-weight: bold;
}

/* Workspaces */
#workspaces button {
    padding: 4px 10px;
    margin: 2px;
    border-radius: 0px;
    color: #aaaaaa;
    background: #1a1a1a;
    border: none;
}

#workspaces button.focused {
    background: #520404;
    color: #e6e6e6;
}

#workspaces button:hover {
    background: #d6002e;
    color: #ffffff;
}

/* Módulos genéricos */
#clock,
#battery,
#network,
#pulseaudio,
#cpu,
#memory {
    padding: 0 12px;
    margin: 0 5px;
    background: #1a1a1a;
    color: #e6e6e6;
    border: none;
}

/* Hover dos módulos */
#clock:hover,
#battery:hover,
#network:hover,
#pulseaudio:hover,
#cpu:hover,
#memory:hover {
    background: #d6002e;
    color: #ffffff;
}

/* Indicador de bateria crítica */
#battery.critical {
    background: #8b0000;
    color: #ffffff;
}

/* Tooltip */
tooltip {
    background: #1a1a1a;
    border: 1px solid #8b0000;
    color: #e6e6e6;
}
